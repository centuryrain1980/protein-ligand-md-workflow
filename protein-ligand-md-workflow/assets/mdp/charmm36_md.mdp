; 生产 MD —— CHARMM36 蛋白-配体复合体
; 依据: GROMACS 官方手册 CHARMM36 强制 mdp 设置

title                   = Protein-ligand complex production MD (CHARMM36)

integrator              = md
nsteps                  = 50000000          ; 100 ns @ 2 fs
dt                      = 0.002

nstxout                 = 0
nstvout                 = 0
nstenergy               = 5000
nstlog                  = 5000
nstxout-compressed      = 5000
compressed-x-grps       = System

; 做结合能分析时打开下面这行, .edr 里会出现组间能量项
; energygrps             = Protein LIG Protein_LIG

comm-mode               = Linear
comm-grps               = System

continuation            = yes
constraint_algorithm    = lincs
constraints             = h-bonds
lincs_iter              = 1
lincs_order             = 4

; --- CHARMM36 必需项 ---
cutoff-scheme           = Verlet
nstlist                 = 10
coulombtype             = PME
rcoulomb                = 1.2
vdwtype                 = cutoff
vdw-modifier            = force-switch
rlist                   = 1.2
rvdw                    = 1.2
rvdw-switch             = 1.0
DispCorr                = no
pme_order               = 4
fourierspacing          = 0.16

tcoupl                  = V-rescale
tc-grps                 = Water Non-Water
tau_t                   = 0.1 0.1
ref_t                   = 300 300

pcoupl                  = Parrinello-Rahman
pcoupltype              = isotropic
tau_p                   = 2.0
ref_p                   = 1.0
compressibility         = 4.5e-5
refcoord_scaling        = com

pbc                     = xyz

gen_vel                 = no